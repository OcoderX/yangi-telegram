    <!-- Hints -->
    <string name="AyuNetDiagHintOk">Ping, packet loss and throughput are all within normal range.</string>
    <string name="AyuNetDiagHintNoNetwork">The device reports no usable connection. Check Wi-Fi or mobile data.</string>
    <string name="AyuNetDiagHintConnecting">Telegram is still establishing the connection to the datacenter. This usually takes a second.</string>
    <string name="AyuNetDiagHintUpdating">Telegram is downloading the message history it missed. Speed goes back to normal once it finishes.</string>
    <string name="AyuNetDiagHintProxySlow">Every packet goes through your proxy, and the proxy itself is slow or unreachable. Try another one or turn the proxy off.</string>
    <string name="AyuNetDiagHintHighPing">The round trip to the datacenter takes a long time. A distant datacenter, a busy network or a proxy are the usual causes.</string>
    <string name="AyuNetDiagHintPacketLoss">Requests are timing out. This is usually a weak signal or a congested network.</string>
    <string name="AyuNetDiagHintDataSaver">Android Data Saver limits background traffic on this network. Allow unrestricted data for Telegram to lift the limit.</string>
    <string name="AyuNetDiagHintMetered">Android treats this network as metered, so auto-download and background traffic are reduced.</string>
    <string name="AyuNetDiagHintBatterySaver">Battery Saver throttles background network activity. Turn it off for full speed.</string>
    <string name="AyuNetDiagHintWeakWifi">The Wi-Fi signal is weak, which causes retransmissions and slow transfers. Move closer to the router.</string>

